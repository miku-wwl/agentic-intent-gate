# Verify Ollama with: ollama --version; ollama list
# Confirm the actual installed phi-4-mini tag; never silently select another model.
# Export these values in your shell; the application does not load .env files.
# This example tag was installed at migration time; recheck on your own machine.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=phi4-mini:latest
MODEL_TIMEOUT_SECONDS=28
API_HOST=127.0.0.1
API_PORT=8000
AIG_DB_PATH=.runtime/day2-runs.sqlite3
# Open http://127.0.0.1:8000/ after starting aig-plans.
# Planning-only synthetic service-demo revision is 1, not a live service read.
