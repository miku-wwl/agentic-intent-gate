# Discover the current URL with: foundry server status --output json
# Confirm the actual wire ID using GET {endpoint}/v1/models.
# Export these values in your shell; the application does not load .env files.
# Required: fill these with the current daemon URL and /v1/models wire ID.
# A previous run's ephemeral port or hardware variant is not a default.
FOUNDRY_LOCAL_ENDPOINT=
FOUNDRY_LOCAL_MODEL=
MODEL_TIMEOUT_SECONDS=28
API_HOST=127.0.0.1
API_PORT=8000
# Open http://127.0.0.1:8000/ after starting aig-plans.
# Planning-only synthetic service-demo revision is 1, not a live service read.
