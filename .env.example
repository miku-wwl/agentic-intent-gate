# Copy this file to .env and uncomment exactly one provider block.
# Replace model and API key placeholders with values from your provider account.

# Ollama (the default provider; legacy LOCAL_LLM_* settings also remain supported)
# AIG_LLM_PROVIDER=ollama
# AIG_LLM_MODEL=<installed-ollama-model-tag>
# AIG_LLM_BASE_URL=http://127.0.0.1:11434/v1

# OpenAI
# AIG_LLM_PROVIDER=openai
# AIG_LLM_MODEL=<supported-openai-model-id>
# OPENAI_API_KEY=<OpenAI-secret>

# Anthropic Claude
# AIG_LLM_PROVIDER=anthropic
# AIG_LLM_MODEL=<supported-claude-model-id>
# ANTHROPIC_API_KEY=<Anthropic-secret>

# Operator-trusted OpenAI-compatible HTTPS endpoint (port 443)
# AIG_LLM_PROVIDER=openai-compatible
# AIG_LLM_MODEL=<provider-model-id>
# AIG_LLM_BASE_URL=https://<trusted-provider-host>/v1
# AIG_LLM_API_KEY=<provider-secret>

# Shared settings
MODEL_TIMEOUT_SECONDS=28
API_HOST=127.0.0.1
API_PORT=8000
AIG_DB_PATH=.runtime/day2-runs.sqlite3
