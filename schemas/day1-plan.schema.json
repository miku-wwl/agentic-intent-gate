{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Day 1 planning preview Plan",
  "description": "Proposal shape only. Trusted catalog, target equality, risk aggregation, byte limits, ordering, counts and revision need independent semantic validation. This schema grants no execution rights.",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal", "target", "steps", "risk_class"],
  "properties": {
    "goal": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S"},
    "target": {"$ref": "#/$defs/service_id"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/step"}
    },
    "risk_class": {"enum": ["READ_ONLY", "SIDE_EFFECT", "APPROVAL_REQUIRED"]}
  },
  "$defs": {
    "service_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}(?![\\s\\S])"
    },
    "step": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool_name", "tool_version", "arguments"],
          "properties": {
            "tool_name": {"const": "get_service_record"},
            "tool_version": {"const": "1"},
            "arguments": {
              "type": "object",
              "additionalProperties": false,
              "required": ["service_id"],
              "properties": {"service_id": {"$ref": "#/$defs/service_id"}}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool_name", "tool_version", "arguments"],
          "properties": {
            "tool_name": {"const": "append_service_note"},
            "tool_version": {"const": "1"},
            "arguments": {
              "type": "object",
              "additionalProperties": false,
              "required": ["service_id", "note"],
              "properties": {
                "service_id": {"$ref": "#/$defs/service_id"},
                "note": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "\\S"}
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool_name", "tool_version", "arguments"],
          "properties": {
            "tool_name": {"const": "set_maintenance_mode"},
            "tool_version": {"const": "1"},
            "arguments": {
              "type": "object",
              "additionalProperties": false,
              "required": ["service_id", "enabled", "expected_revision"],
              "properties": {
                "service_id": {"$ref": "#/$defs/service_id"},
                "enabled": {"type": "boolean"},
                "expected_revision": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807}
              }
            }
          }
        }
      ]
    }
  }
}
