    "deleted_lines": 5,
    "exception_precedence": "Capture and rethrow established ActionError, BindingError, RunStoreError identities; ordinary cleanup failures add only a fixed safe note. Untyped ordinary failures retain DATABASE_UNAVAILABLE; cleanup-only failure remains fail-closed.",
    "rollback_behavior": "Attempt rollback when in_transaction is true. Inspection failure does not fabricate rollback; rollback failure cannot prevent close.",
    "close_behavior": "Existing inner finally independently attempts close. Preserving a primary error is not a universal physical-release guarantee.",
    "safe_cleanup_note": "Action transaction cleanup failed.",
    "commit_uncertainty": "No false success or rollback claim; COMMIT or close-acknowledgment uncertainty returns safe storage unavailability. No automatic retry; durable unconfirmed claim returns no dispatch permission.",
    "control_flow": "BaseException is captured solely to immediately rethrow the same primary control-flow object. Ordinary cleanup faults cannot reclassify it; new cleanup control-flow signals propagate.",
    "changed_transaction_boundaries": false,
    "retries_added": false,
    "schema_changed": false,
    "states_changed": false,
    "auth_policy_changed": false,
    "http_mapping_changed": false
